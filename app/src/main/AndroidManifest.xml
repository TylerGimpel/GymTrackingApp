<?xml version="1.0" encoding="utf-8"?>
<!--
  Three permissions, all for the rest timer, and all the askable kind.

  The exercise bank ships inside the APK so the app has nothing to fetch, and no network
  permission belongs here (docs/adr/0002-exercise-bank-source-and-omissions.md).

  Deliberately absent, and to stay absent: USE_EXACT_ALARM, which schedules exact alarms without
  asking, and REQUEST_IGNORE_BATTERY_OPTIMIZATIONS. Both risk Play rejection for an app that is
  not an alarm clock, and both are the sort of thing added in a hurry when a timer fires late.
  The honest answer to a denied permission is to tell the lifter, which the app does.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Denied by default on Android 12+, and again after a backup restore. The app checks. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The countdown and the alert. Runtime-granted on Android 13+, and asked for. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The alert channel vibrates, which is how it reaches a pocket in a loud gym. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_sort_by_size"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymTracker">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GymTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- What the alarm wakes. Not exported: nothing outside the app has business firing it. -->
        <receiver
            android:name=".rest.RestOverReceiver"
            android:exported="false" />
    </application>

</manifest>
